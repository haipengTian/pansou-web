# 这是前端 + 你的 production 后端组成的一体镜像。
# 回滚时可改为不可变标签，例如 sha-a1b2c3d。
PANSOU_IMAGE=ghcr.io/haipengtian/pansou-web:production

# 网页监听配置
WEB_BIND_ADDRESS=0.0.0.0
WEB_HTTP_PORT=80
DOMAIN=localhost
TZ=Asia/Shanghai

# 一体容器内部后端配置，请勿改为宿主机地址。
PANSOU_HOST=127.0.0.1
PANSOU_PORT=8888

# 搜索来源。可按服务器性能逐步增加。
CHANNELS=tgsearchers7
ASYNC_PLUGIN_ENABLED=true
ENABLED_PLUGINS=pansearch,duoduo,quarksoo,quark4k,zhizhen,shandian

# 缓存和并发
CACHE_ENABLED=true
CACHE_PATH=/app/data/cache
CACHE_MAX_SIZE=100
CACHE_TTL=60
CACHE_WRITE_STRATEGY=hybrid
PLUGIN_TIMEOUT=10
ASYNC_RESPONSE_TIMEOUT=4
ASYNC_MAX_BACKGROUND_WORKERS=20
ASYNC_MAX_BACKGROUND_TASKS=100
ASYNC_CACHE_TTL_HOURS=1
OUTBOUND_MAX_CONCURRENCY=128

# 公网部署必须配置认证。
# 格式：用户名:密码；多个用户以英文逗号分隔。
AUTH_ENABLED=true
AUTH_USERS=
AUTH_TOKEN_EXPIRY=24
AUTH_JWT_SECRET=

# 需要代理时取消注释。
# PROXY=socks5://127.0.0.1:1080
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
INSECURE_SKIP_TLS_VERIFY=false
